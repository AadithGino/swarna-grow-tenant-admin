{
  "name": "swarnagrow-portals",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "frozen-install": "pnpm install --frozen-lockfile",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "NODE_ENV=production node scripts/validate-production-public-env.mjs && node scripts/run-framework.mjs build",
    "build:vercel": "NODE_ENV=production node scripts/validate-production-public-env.mjs && NITRO_PRESET=vercel DEPLOY_TARGET=vercel node scripts/run-framework.mjs build",
    "build:netlify": "NODE_ENV=production node scripts/validate-production-public-env.mjs && node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint src components app lib hooks --max-warnings 0",
    "lint:customer": "eslint src/features/customer src/components/customer src/app/customer-router.tsx src/store/api/customer-api.ts src/store/slices/customer-session-slice.ts --max-warnings 0",
    "lint:agent": "eslint src/features/agent src/components/agent src/app/agent-router.tsx src/store/api/agent-api.ts src/store/slices/agent-session-slice.ts src/mocks/agent-data.ts --max-warnings 0",
    "test": "vitest run",
    "test:phase4": "vitest run src/config/env.production.test.ts && node --test scripts/validate-production-public-env.test.mjs",
    "typecheck": "tsc --noEmit",
    "package:export": "node scripts/package-source-export.mjs",
    "package:verify": "node scripts/verify-source-export-manifest.mjs",
    "guides:export": "node scripts/export-guides.mjs",
    "guides:check": "node scripts/check-guides.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-virtual": "^3.14.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "happy-dom": "^20.0.11",
    "nitro": "3.0.260903-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
