NEXT_PUBLIC_API_BASE_URL=https://api.swarnagrow.com/api/v1

# Default (when unset): true — all portals use contract-shaped mock data.
# Set to false when connecting to the live API (or local backend).
NEXT_PUBLIC_USE_MOCKS=true

# Production builds (NODE_ENV=production): fail closed — NEXT_PUBLIC_USE_MOCKS must be false,
# NEXT_PUBLIC_API_BASE_URL must be https, end with /api/v1, not localhost; mock payment test UI forbidden.

# Optional: only used when NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_MOCK_DELAY_MS=420

# Customer portal: must match Tenant.code in the API (e.g. DEMO). Used when the URL has no slug (/customer/login).
# Prefer jeweller links: /customer/<code>/login (lowercase slug → uppercase tenant code).
NEXT_PUBLIC_CUSTOMER_TENANT_CODE=

# Deprecated for login — use per-jeweller URLs: /agent/<slug>/login (e.g. /agent/kairali/login).
# NEXT_PUBLIC_AGENT_TENANT_CODE=

# Netlify / static vinext: full page navigation for admin sidebar (recommended).
# NEXT_PUBLIC_PORTAL_HARD_NAV=true

# Flutter hosted PhonePe return (origin must be in backend CORS_ORIGINS + https in prod).
# Production:
# NEXT_PUBLIC_FLUTTER_PAYMENT_RETURN_URL=https://swarnagrow-tenant-admin.vercel.app/payment-return
# Local (vinext on :5173):
NEXT_PUBLIC_FLUTTER_PAYMENT_RETURN_URL=http://localhost:5173/payment-return
# Deep link opened from /payment-return bridge (register same scheme in Flutter).
NEXT_PUBLIC_FLUTTER_APP_DEEP_LINK=evoluxe://payment-return
