NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Default (when unset): false — portal calls swarnagrow-backend on :4000.
# Set to true for offline UI demo with mock-server only (no backend required).
NEXT_PUBLIC_USE_MOCKS=false

# Optional: only used when NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_MOCK_DELAY_MS=420
